{
  "plan": {
    "steps": [
      {
        "id": "session",
        "kind": "session",
        "mode": "create",
        "title": "Voltage Divider",
        "output_path": "C:/Circuits/divider.ms14"
      },
      {
        "id": "wiring",
        "kind": "wiring",
        "connect_touching": false,
        "autowire_on_connection": true
      },
      {
        "id": "build",
        "kind": "edit",
        "operations": [
          {
            "operation": "place",
            "bind": "supply",
            "arguments": {
              "name": "DC_POWER",
              "ref": "V1",
              "x": 180,
              "y": 180,
              "anchor": "pin",
              "pin": "1",
              "params": {
                "voltage": 12
              }
            }
          },
          {
            "operation": "place",
            "bind": "upper",
            "arguments": {
              "name": "RESISTOR_VIRTUAL",
              "ref": "R1",
              "x": 360,
              "y": 180,
              "angle": 90,
              "anchor": "pin",
              "pin": "1",
              "family": "RESISTOR",
              "group": "Basic",
              "params": {
                "resistance": "1k"
              }
            }
          },
          {
            "operation": "place",
            "bind": "lower",
            "arguments": {
              "name": "RESISTOR_VIRTUAL",
              "ref": "R2",
              "x": 360,
              "y": 297,
              "angle": 90,
              "anchor": "pin",
              "pin": "1",
              "family": "RESISTOR",
              "group": "Basic",
              "params": {
                "resistance": "2k"
              }
            }
          },
          {
            "operation": "place",
            "bind": "ground",
            "arguments": {
              "name": "GROUND",
              "x": 270,
              "y": 414,
              "anchor": "pin",
              "pin": "1"
            }
          },
          {
            "operation": "wire",
            "bind": "w_in",
            "arguments": {
              "source": { "ref": { "$ref": "supply.component.id" }, "pin": "1" },
              "target": { "ref": { "$ref": "upper.component.id" }, "pin": "1" }
            }
          },
          {
            "operation": "wire",
            "bind": "w_out",
            "arguments": {
              "source": { "ref": { "$ref": "upper.component.id" }, "pin": "2" },
              "target": { "ref": { "$ref": "lower.component.id" }, "pin": "1" }
            }
          },
          {
            "operation": "wire",
            "arguments": {
              "source": { "ref": { "$ref": "supply.component.id" }, "pin": "2" },
              "target": { "ref": { "$ref": "ground.component.id" }, "pin": "1" }
            }
          },
          {
            "operation": "wire",
            "arguments": {
              "source": { "ref": { "$ref": "lower.component.id" }, "pin": "2" },
              "target": { "ref": { "$ref": "ground.component.id" }, "pin": "1" }
            }
          },
          {
            "operation": "labelWire",
            "arguments": { "id": { "$ref": "w_in.id" }, "name": "VIN" }
          },
          {
            "operation": "labelWire",
            "arguments": { "id": { "$ref": "w_out.id" }, "name": "VOUT" }
          },
          {
            "operation": "fitSheet",
            "arguments": { "margin": 36, "resize": true }
          }
        ]
      },
      {
        "id": "layout",
        "kind": "layout",
        "repair_geometry": true
      },
      {
        "id": "op",
        "kind": "analysis",
        "options": { "analysis": "op" },
        "measurements": [
          {
            "id": "midpoint",
            "metric": "mean",
            "signal": { "component_ref": { "$ref": "lower.component.id" }, "pin": "1" }
          },
          {
            "id": "current",
            "metric": "mean",
            "signal": { "current": { "$ref": "supply.component.id" } }
          }
        ],
        "criteria": [
          { "id": "midpoint", "target": 8, "absolute_tolerance": 0.001 },
          { "id": "current", "target": -0.004, "absolute_tolerance": 1e-06 }
        ]
      },
      {
        "id": "dc_sweep",
        "kind": "analysis",
        "options": {
          "analysis": "dc",
          "dc_source": "V1",
          "dc_start": 0,
          "dc_stop": 12,
          "dc_step": 1
        },
        "measurements": [
          {
            "id": "vout_at_6v",
            "metric": "value_at",
            "signal": { "component_ref": { "$ref": "lower.component.id" }, "pin": "1" },
            "at": 6
          }
        ],
        "criteria": [
          { "id": "vout_at_6v", "target": 4, "absolute_tolerance": 0.001 }
        ]
      },
      {
        "id": "save",
        "kind": "save",
        "save_to_source": true
      },
      {
        "id": "image",
        "kind": "export",
        "output_path": "C:/Circuits/divider.png",
        "dpi": 192,
        "fit_content": true,
        "padding": 27
      },
      {
        "id": "close",
        "kind": "close"
      }
    ]
  },
  "wait_timeout": 60
}
